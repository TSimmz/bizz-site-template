    {
      "id": "DCTDGKl6WMAjWHJzUzgAT",
      "type": "text",
      "x": -1372.067919077581,
      "y": -1733.8433174685838,
      "width": 329.79608284771894,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aj",
      "roundness": null,
      "seed": 1775767321,
      "version": 719,
      "versionNonce": 2018695129,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1785644323415,
      "link": null,
      "locked": false,
      "text": "1. Pull up all proposals\n2. Divide by monetary scale\n3. Allow for favorites\n4. Display total grant amount at\ntop of screen\n5. Deduct as grants are chosen\nto be funded\n6. Review will be event. People\njoin in order to vote.\n7. Create voting platform like\nJackBox",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Pull up all proposals\n2. Divide by monetary scale\n3. Allow for favorites\n4. Display total grant amount at top of screen\n5. Deduct as grants are chosen to be funded\n6. Review will be event. People join in order to vote.\n7. Create voting platform like JackBox",
      "autoResize": false,
      "lineHeight": 1.25
    },
